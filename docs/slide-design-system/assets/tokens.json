{
  "name": "slide-design-system",
  "version": "1.0.0",
  "canvas": {
    "width_pt": 960,
    "height_pt": 540,
    "ratio": "16:9"
  },
  "color": {
    "primary": "#1B2A49",
    "primary-tint": "#EEF1F6",
    "accent": "#C41230",
    "accent-tint": "#FBE9EC",
    "warning": "#8A5A00",
    "warning-tint": "#FFF6DD",
    "success": "#2F855A",
    "danger": "#B42318",
    "ink": "#0F172A",
    "slate": "#55595F",
    "border": "#D5DCE6",
    "surface": "#FFFFFF",
    "surface-alt": "#F6F7F9",
    "on-primary": "#FFFFFF",
    "wordmark-gray": "#BDBDBD",
    "header-label": "#4B4B4B",
    "highlight": "#FDB515",
    "iron": "#6D6E71"
  },
  "font": {
    "text": [
      "Open Sans",
      "Helvetica",
      "Arial",
      "sans-serif"
    ],
    "code": [
      "JetBrains Mono",
      "Consolas",
      "Menlo",
      "Courier New",
      "monospace"
    ],
    "wordmark": [
      "Bodoni MT",
      "Libre Bodoni",
      "Playfair Display",
      "Georgia",
      "serif"
    ]
  },
  "type": {
    "display": {
      "size": 44,
      "weight": "bold",
      "color": "primary",
      "line": 1.1
    },
    "title": {
      "size": 32,
      "weight": "bold",
      "color": "primary",
      "line": 1.15
    },
    "lead": {
      "size": 20,
      "weight": "regular",
      "color": "slate",
      "line": 1.3
    },
    "body": {
      "size": 18,
      "weight": "regular",
      "color": "ink",
      "line": 1.35
    },
    "label": {
      "size": 14,
      "weight": "bold",
      "color": "primary",
      "line": 1.2
    },
    "caption": {
      "size": 12,
      "weight": "regular",
      "color": "slate",
      "line": 1.2
    },
    "code": {
      "size": 16,
      "weight": "regular",
      "color": "ink",
      "line": 1.3
    },
    "stat": {
      "size": 54,
      "weight": "bold",
      "color": "accent",
      "line": 1.0
    },
    "wordmark": {
      "size": 20,
      "weight": "regular",
      "color": "wordmark-gray",
      "line": 1.0
    },
    "header-label": {
      "size": 14,
      "weight": "bold",
      "color": "header-label",
      "line": 1.0,
      "letter_spacing_pt": 1.5,
      "case": "upper"
    }
  },
  "space": {
    "margin_x": 48,
    "margin_top": 36,
    "gutter": 24,
    "pad": 16,
    "radius": 8,
    "stroke": 1,
    "arrow_stroke": 2
  },
  "zones": {
    "header": {
      "y": 18,
      "h": 28
    },
    "title": {
      "y": 50,
      "h": 56
    },
    "lead": {
      "y": 108,
      "h": 24
    },
    "content": {
      "y": 142,
      "h": 310
    },
    "takeaway": {
      "y": 456,
      "h": 36
    },
    "footer": {
      "y": 504,
      "h": 24
    }
  },
  "limits": {
    "max_bullets": 6,
    "max_words_per_bullet": 12,
    "max_cards_per_row": 3,
    "max_flow_steps": 7,
    "min_body_pt": 16,
    "talking_points_max": 5,
    "talking_points_words": [
      40,
      80
    ],
    "full_text_words": [
      90,
      170
    ]
  },
  "tartan": {
    "height_pt": 4,
    "y_pt": 0,
    "segments": [
      [
        30,
        "accent"
      ],
      [
        10,
        "highlight"
      ],
      [
        30,
        "surface"
      ],
      [
        10,
        "iron"
      ],
      [
        20,
        "accent"
      ]
    ]
  },
  "shadow": {
    "card": {
      "color": "1B2A49",
      "opacity": 0.14,
      "blur_pt": 10,
      "offset_pt": 3,
      "angle": 90
    }
  },
  "terminal": {
    "fill": "#23262B",
    "dots": [
      "#EF6B6B",
      "#F5C542",
      "#6BD48C"
    ],
    "title": "#9AA1AB",
    "text": "#E6E8EB",
    "rule": "#3A3F47"
  }
}