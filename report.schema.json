{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MedTech baseline report",
  "type": "object",
  "required": [
    "schema_version",
    "baseline",
    "run_id",
    "generated_at",
    "mode",
    "scope",
    "disclaimer",
    "summary",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "baseline": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "SIMULATED",
        "AWS_READ_ONLY_SCAN"
      ]
    },
    "disclaimer": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "account_id",
        "regions",
        "buckets"
      ],
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "type": "string",
          "pattern": "^[0-9]{12}$"
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "buckets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "status",
        "coverage",
        "counts",
        "assessed_pass_percent",
        "risk_counts",
        "controls"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "INCOMPLETE"
          ]
        },
        "coverage": {
          "enum": [
            "INCOMPLETE",
            "COMPLETE_WITHIN_SCOPE"
          ]
        },
        "counts": {
          "type": "object",
          "required": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ],
          "additionalProperties": false,
          "properties": {
            "PASS": {
              "type": "integer",
              "minimum": 0
            },
            "FAIL": {
              "type": "integer",
              "minimum": 0
            },
            "UNKNOWN": {
              "type": "integer",
              "minimum": 0
            },
            "NOT_APPLICABLE": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "assessed_pass_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "risk_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "controls": {
          "type": "object",
          "required": [
            "S3_PUBLIC_ACCESS",
            "S3_ENCRYPTION",
            "IAM_MFA",
            "EC2_ADMIN_PORTS",
            "CLOUDTRAIL_LOGGING"
          ],
          "additionalProperties": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "NOT_APPLICABLE"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "control_id",
          "resource",
          "region",
          "status",
          "severity",
          "reason",
          "evidence",
          "remediation"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{20}$"
          },
          "control_id": {
            "enum": [
              "S3_PUBLIC_ACCESS",
              "S3_ENCRYPTION",
              "IAM_MFA",
              "EC2_ADMIN_PORTS",
              "CLOUDTRAIL_LOGGING"
            ]
          },
          "resource": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "NOT_APPLICABLE"
            ]
          },
          "severity": {
            "enum": [
              "INFORMATIONAL",
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "object"
          },
          "remediation": {
            "type": "string"
          }
        }
      }
    }
  }
}
